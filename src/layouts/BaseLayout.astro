---
import '../styles/global.css';
import config from '../config/site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PhoneBar from '../components/PhoneBar.astro';
import { withBase } from '../lib/paths';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = config.seo.defaultTitle,
  description = config.seo.defaultDescription,
} = Astro.props;

const pageTitle =
  title === config.seo.defaultTitle
    ? title
    : config.seo.titleTemplate.replace('%s', title);

const fonts = config.fonts;
const layoutClass = config.layout === 'shopfront' ? 'layout-shopfront' : 'layout-default';
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content={config.colours.primary} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    {
      fonts && (
        <>
          <link rel="preconnect" href="https://fonts.googleapis.com" />
          <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
          <link rel="stylesheet" href={fonts.googleHref} />
        </>
      )
    }
    {
      !fonts && (
        <link
          rel="stylesheet"
          href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
        />
      )
    }
    <title>{pageTitle}</title>
    <style
      set:html={`
      :root {
        --color-primary: ${config.colours.primary};
        --color-secondary: ${config.colours.secondary};
        --color-accent: ${config.colours.accent};
        --color-muted: ${config.colours.muted};
        ${
          fonts
            ? `--font-sans: "${fonts.sans}", system-ui, sans-serif; --font-display: "${fonts.display}", system-ui, sans-serif;`
            : ''
        }
      }
    `}
    />
  </head>
  <body class:list={['flex min-h-screen flex-col', layoutClass]}>
    <PhoneBar />
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>

---
import config from '../config/site.config';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
import LogoMark from './LogoMark.astro';

const base = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const rawPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathname = rawPath.startsWith(base) ? rawPath.slice(base.length) || '/' : rawPath;

const links = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];

function isActive(href: string) {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
}

const logoSrc = config.logoSrc ? withBase(config.logoSrc) : null;
const isShopfront = config.layout === 'shopfront';
const isCoastal = config.layout === 'coastal';
const headerBg = isShopfront
  ? 'bg-[#FFFCF8]/95'
  : isCoastal
    ? 'bg-[#FFF5EC]/95'
    : 'bg-white/95';
const showWordmarkOnly = Boolean(logoSrc && config.logoWordmark);
---

<header class:list={['sticky top-0 z-40 border-b border-slate-200/80 backdrop-blur-md', headerBg]}>
  <div class="container-page flex h-[4.25rem] items-center justify-between gap-3 sm:h-[4.5rem]">
    <a href={withBase('/')} class="group flex min-w-0 items-center gap-3">
      {
        logoSrc ? (
          <img
            src={logoSrc}
            alt={showWordmarkOnly ? config.firmName : ''}
            width={showWordmarkOnly ? 220 : 48}
            height={showWordmarkOnly ? 48 : 28}
            class:list={[
              'shrink-0 object-contain object-left',
              showWordmarkOnly ? 'h-10 w-auto max-w-[min(100%,220px)] sm:h-11 sm:max-w-[260px]' : 'h-9 w-auto sm:h-10',
            ]}
          />
        ) : (
          <LogoMark firmName={config.firmName} size={40} />
        )
      }
      {
        !showWordmarkOnly && (
          <span class="min-w-0 flex flex-col">
            <span class="truncate font-display text-base font-semibold leading-tight text-brand-primary group-hover:text-brand-secondary sm:text-lg">
              {config.firmName}
            </span>
            <span class="hidden truncate text-xs text-slate-500 sm:block">
              {config.suburb} · {config.region}
            </span>
          </span>
        )
      }
    </a>

    <nav class="hidden items-center gap-0.5 lg:flex" aria-label="Primary">
      {
        links.map((link) => (
          <a
            href={withBase(link.href)}
            class:list={[
              'rounded-lg px-3.5 py-2 text-sm font-medium',
              isActive(link.href)
                ? isCoastal
                  ? 'text-brand-secondary border-b-2 border-brand-primary rounded-none'
                  : 'bg-brand-muted text-brand-primary'
                : 'text-slate-600 hover:bg-slate-50 hover:text-brand-primary',
            ]}
            aria-current={isActive(link.href) ? 'page' : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-2">
      <a
        href={config.phoneHref}
        class="btn-primary hidden !min-h-0 !py-2.5 !px-4 text-xs sm:inline-flex sm:text-sm"
      >
        <Icon name="phone" size={16} />
        <span class="whitespace-nowrap">{config.phone}</span>
      </a>

      <details class="relative lg:hidden">
        <summary
          class="menu-btn flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-xl border border-slate-200 bg-white text-brand-primary shadow-sm"
          aria-label="Open menu"
        >
          <Icon name="menu" size={22} />
        </summary>
        <div class="absolute right-0 mt-2 w-56 rounded-2xl border border-slate-200 bg-white p-2 shadow-xl">
          {
            links.map((link) => (
              <a
                href={withBase(link.href)}
                class:list={[
                  'block rounded-xl px-3.5 py-3 text-sm font-medium',
                  isActive(link.href) ? 'bg-brand-muted text-brand-primary' : 'text-slate-700 hover:bg-slate-50',
                ]}
              >
                {link.label}
              </a>
            ))
          }
          <a
            href={config.phoneHref}
            class="mt-1.5 flex items-center justify-center gap-2 rounded-xl bg-brand-primary px-3.5 py-3 text-sm font-semibold text-white"
          >
            <Icon name="phone" size={16} />
            Call {config.phone}
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

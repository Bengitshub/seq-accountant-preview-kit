---
import config from '../config/site.config';
---

<section class="bg-brand-muted">
  <div class="container-page section-pad">
    <div class="card flex flex-col items-start gap-6 border-brand-primary/10 bg-white md:flex-row md:items-center md:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl sm:text-3xl">{config.cta.headline}</h2>
        <p class="mt-3 text-slate-600">{config.cta.body}</p>
      </div>
      <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
        <a href={config.phoneHref} class="btn-primary w-full sm:w-auto">{config.cta.buttonLabel}</a>
        <a href="/contact" class="btn-secondary w-full sm:w-auto">Send a message</a>
      </div>
    </div>
  </div>
</section>

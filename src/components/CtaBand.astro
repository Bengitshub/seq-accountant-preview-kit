---
import config from '../config/site.config';
import { withBase } from '../lib/paths';
import Icon from './Icon.astro';
---

<section class="bg-brand-muted">
  <div class="container-page section-pad !py-12 sm:!py-16">
    <div class="relative overflow-hidden rounded-3xl border border-brand-primary/10 bg-white p-8 shadow-sm sm:p-10">
      <div
        class="pointer-events-none absolute -right-16 -top-16 h-56 w-56 rounded-full bg-brand-muted opacity-80"
        aria-hidden="true"
      ></div>
      <div class="relative flex flex-col items-start gap-6 md:flex-row md:items-center md:justify-between">
        <div class="max-w-xl">
          <p class="eyebrow">Next step</p>
          <h2 class="mt-2 text-2xl sm:text-3xl">{config.cta.headline}</h2>
          <p class="mt-3 text-slate-600 leading-relaxed">{config.cta.body}</p>
        </div>
        <div class="flex w-full flex-col gap-3 sm:w-auto sm:flex-row">
          <a href={config.phoneHref} class="btn-primary w-full sm:w-auto">
            <Icon name="phone" size={16} />
            {config.cta.buttonLabel}
          </a>
          <a href={withBase('/contact')} class="btn-secondary w-full sm:w-auto">
            Send a message
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>
    </div>
  </div>
</section>

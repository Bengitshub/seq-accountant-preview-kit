---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import config from '../config/site.config';

const title = 'About';
const description = `Meet ${config.firmName} — accountants based in ${config.suburb}, serving ${config.region}.`;
---

<BaseLayout title={title} description={description}>
  <section class="bg-brand-muted">
    <div class="container-page section-pad !pb-12">
      <p class="text-sm font-semibold uppercase tracking-wider text-brand-secondary">Our practice</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">About {config.firmName}</h1>
      <p class="mt-4 max-w-2xl text-lg text-slate-600">{config.about.intro}</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-5 text-slate-700 leading-relaxed">
        {config.about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <aside class="card h-fit bg-brand-muted border-transparent">
        <h2 class="text-xl">Why clients stay</h2>
        <ul class="mt-4 space-y-3">
          {
            config.about.highlights.map((item) => (
              <li class="flex gap-2 text-sm text-slate-700">
                <span class="font-bold text-brand-accent" aria-hidden="true">✓</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        {config.addressLine && (
          <div class="mt-6 border-t border-slate-200 pt-6 text-sm text-slate-600">
            <p class="font-semibold text-brand-primary">Visit</p>
            <p class="mt-1">{config.addressLine}</p>
            <p class="mt-1">Appointments preferred</p>
          </div>
        )}
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

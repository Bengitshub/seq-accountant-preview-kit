---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import config from '../config/site.config';

const title = 'About';
const description = `Meet ${config.firmName} — accountants based in ${config.suburb}, serving ${config.region}.`;
---

<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden bg-brand-muted">
    <div class="container-page section-pad !pb-14">
      <p class="eyebrow">Our practice</p>
      <h1 class="mt-3 max-w-3xl text-4xl sm:text-5xl">About {config.firmName}</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">{config.about.intro}</p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page grid gap-10 lg:grid-cols-12 lg:gap-12">
      <div class="lg:col-span-7 space-y-5 text-slate-700 leading-relaxed">
        {config.about.paragraphs.map((p) => <p class="text-[0.975rem] sm:text-base">{p}</p>)}
      </div>
      <aside class="lg:col-span-5">
        <div class="card h-fit border-transparent bg-brand-muted p-7">
          <h2 class="text-xl">Why clients stay</h2>
          <ul class="mt-5 space-y-3.5">
            {
              config.about.highlights.map((item) => (
                <li class="flex gap-2.5 text-sm text-slate-700">
                  <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-white text-brand-primary shadow-sm">
                    <Icon name="check" size={12} />
                  </span>
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
          {
            config.addressLine && (
              <div class="mt-7 border-t border-slate-200/80 pt-6 text-sm text-slate-600">
                <p class="flex items-center gap-2 font-semibold text-brand-primary">
                  <Icon name="map-pin" size={16} />
                  Visit
                </p>
                <p class="mt-2 leading-relaxed">{config.addressLine}</p>
                <p class="mt-1 text-slate-500">Appointments preferred</p>
              </div>
            )
          }
          <a href={config.phoneHref} class="btn-primary mt-7 w-full">
            <Icon name="phone" size={16} />
            Call {config.phone}
          </a>
        </div>
      </aside>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

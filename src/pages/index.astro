---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import config from '../config/site.config';
import { withBase } from '../lib/paths';
---

<BaseLayout>
  <!-- Hero -->
  <section class="relative overflow-hidden">
    <div class="absolute inset-0 bg-brand-muted" aria-hidden="true"></div>
    <div
      class="pointer-events-none absolute -right-24 top-0 h-[420px] w-[420px] rounded-full bg-white/60 blur-3xl"
      aria-hidden="true"
    ></div>
    <div
      class="pointer-events-none absolute -left-20 bottom-0 h-72 w-72 rounded-full bg-brand-accent/10 blur-2xl"
      aria-hidden="true"
    ></div>

    <div class="container-page relative section-pad">
      <div class="grid items-center gap-12 lg:grid-cols-12 lg:gap-10">
        <div class="lg:col-span-7">
          <p class="eyebrow">Accountants in {config.suburb}</p>
          <h1 class="mt-4 max-w-2xl text-[1.85rem] leading-[1.15] sm:text-4xl lg:text-[2.75rem]">
            {config.hero.headline}
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
            {config.hero.subheadline}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
            <a href={config.phoneHref} class="btn-primary">
              <Icon name="phone" size={16} />
              {config.hero.primaryCta}
            </a>
            <a href={withBase('/services')} class="btn-secondary">
              {config.hero.secondaryCta}
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
          {
            config.socialProof && (
              <ul class="mt-9 grid gap-3 sm:grid-cols-1">
                {config.socialProof.map((item) => (
                  <li class="flex items-start gap-2.5 text-sm text-slate-600">
                    <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-accent/20 text-brand-primary">
                      <Icon name="check" size={12} />
                    </span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="lg:col-span-5">
          <div class="card border-brand-primary/10 bg-white/95 p-7 shadow-md backdrop-blur">
            <p class="eyebrow text-brand-accent">At a glance</p>
            <h2 class="mt-2 text-2xl">How we typically help</h2>
            <ul class="mt-6 space-y-1">
              {
                config.services.slice(0, 4).map((service, i) => (
                  <li>
                    <a
                      href={`${withBase('/services')}#${service.slug}`}
                      class="group flex gap-3 rounded-xl p-3 -mx-1 transition hover:bg-brand-muted/70"
                    >
                      <span class="service-icon !h-9 !w-9 text-xs font-bold">{String(i + 1).padStart(2, '0')}</span>
                      <span class="min-w-0">
                        <span class="block font-semibold text-brand-primary group-hover:text-brand-secondary">
                          {service.title}
                        </span>
                        <span class="mt-0.5 block text-sm leading-snug text-slate-600 line-clamp-2">
                          {service.summary}
                        </span>
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>
            <a href={withBase('/contact')} class="btn-accent mt-6 w-full">
              Request a callback
              <Icon name="arrow-right" size={16} />
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Services grid -->
  <section class="section-pad">
    <div class="container-page">
      <div class="max-w-2xl">
        <p class="eyebrow">What we offer</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Services built for busy owners</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">
          From year-end lodgement to month-to-month bookkeeping, we keep the compliance load predictable
          so you can focus on the business.
        </p>
      </div>
      <div class="mt-10 grid gap-5 sm:grid-cols-2">
        {
          config.services.map((service, i) => (
            <article class="card group flex flex-col p-7 transition hover:border-brand-secondary/35 hover:shadow-md">
              <div class="flex items-start justify-between gap-3">
                <span class="service-icon">
                  <Icon name="spark" size={18} />
                </span>
                <span class="text-xs font-semibold tabular-nums text-slate-400">
                  {String(i + 1).padStart(2, '0')}
                </span>
              </div>
              <h3 class="mt-5 text-xl">{service.title}</h3>
              <p class="mt-3 flex-1 text-sm leading-relaxed text-slate-600">{service.summary}</p>
              <a
                href={`${withBase('/services')}#${service.slug}`}
                class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-secondary hover:text-brand-primary"
              >
                Learn more
                <Icon name="chevron-right" size={16} />
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- About teaser -->
  <section class="border-y border-slate-200 bg-white">
    <div class="container-page section-pad grid gap-10 lg:grid-cols-2 lg:items-center lg:gap-14">
      <div>
        <p class="eyebrow">Our practice</p>
        <h2 class="mt-3 text-3xl sm:text-4xl">Local advice. Direct access.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">{config.about.intro}</p>
        <ul class="mt-7 space-y-3.5">
          {
            config.about.highlights.map((item) => (
              <li class="flex gap-3 text-sm text-slate-700">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-brand-muted text-brand-primary">
                  <Icon name="check" size={12} />
                </span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a href={withBase('/about')} class="btn-secondary mt-8">
          About the practice
          <Icon name="arrow-right" size={16} />
        </a>
      </div>
      <div class="relative overflow-hidden rounded-3xl bg-brand-primary p-8 text-white shadow-lg sm:p-10">
        <div
          class="pointer-events-none absolute -right-10 -top-10 h-40 w-40 rounded-full bg-white/5"
          aria-hidden="true"
        ></div>
        <p class="font-display text-2xl leading-snug sm:text-3xl">
          “We explain the options, file on time, and pick up the phone.”
        </p>
        <p class="mt-6 text-sm leading-relaxed text-slate-300">
          That is the standard we set for every engagement — whether you are lodging a first company return
          or tightening BAS routines across a multi-site operation.
        </p>
        <a href={config.phoneHref} class="btn-accent mt-8">
          <Icon name="phone" size={16} />
          {config.hero.primaryCta}
        </a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

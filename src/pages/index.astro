---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import config from '../config/site.config';
---

<BaseLayout>
  <section class="relative overflow-hidden bg-brand-muted">
    <div class="container-page section-pad">
      <div class="grid items-center gap-10 lg:grid-cols-2">
        <div>
          <p class="text-sm font-semibold uppercase tracking-wider text-brand-secondary">
            Accountants in {config.suburb}
          </p>
          <h1 class="mt-3 text-3xl leading-tight sm:text-4xl lg:text-5xl">
            {config.hero.headline}
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
            {config.hero.subheadline}
          </p>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row">
            <a href={config.phoneHref} class="btn-primary">{config.hero.primaryCta}</a>
            <a href="/services" class="btn-secondary">{config.hero.secondaryCta}</a>
          </div>
          {
            config.socialProof && (
              <ul class="mt-8 flex flex-col gap-2 text-sm text-slate-600 sm:flex-row sm:flex-wrap sm:gap-x-6">
                {config.socialProof.map((item) => (
                  <li class="flex items-start gap-2">
                    <span class="mt-0.5 text-brand-accent" aria-hidden="true">✓</span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )
          }
        </div>

        <div class="card border-brand-primary/10 bg-white shadow-md">
          <p class="text-sm font-semibold uppercase tracking-wide text-brand-accent">At a glance</p>
          <h2 class="mt-2 text-2xl">How we typically help</h2>
          <ul class="mt-6 space-y-4">
            {
              config.services.slice(0, 4).map((service) => (
                <li class="border-b border-slate-100 pb-4 last:border-0 last:pb-0">
                  <a href={`/services#${service.slug}`} class="group block">
                    <p class="font-semibold text-brand-primary group-hover:text-brand-secondary">
                      {service.title}
                    </p>
                    <p class="mt-1 text-sm text-slate-600">{service.summary}</p>
                  </a>
                </li>
              ))
            }
          </ul>
          <a href="/contact" class="btn-accent mt-6 w-full">Request a callback</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page">
      <div class="max-w-2xl">
        <h2 class="text-3xl sm:text-4xl">Services built for busy owners</h2>
        <p class="mt-4 text-slate-600">
          From year-end lodgement to month-to-month bookkeeping, we keep the compliance load predictable
          so you can focus on the business.
        </p>
      </div>
      <div class="mt-10 grid gap-6 sm:grid-cols-2">
        {
          config.services.map((service) => (
            <article class="card hover:border-brand-secondary/40">
              <h3 class="text-xl">{service.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-slate-600">{service.summary}</p>
              <a
                href={`/services#${service.slug}`}
                class="mt-4 inline-flex text-sm font-semibold text-brand-secondary hover:text-brand-primary"
              >
                Learn more →
              </a>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="border-y border-slate-200 bg-white">
    <div class="container-page section-pad grid gap-10 lg:grid-cols-2 lg:items-center">
      <div>
        <h2 class="text-3xl sm:text-4xl">Local advice. Direct access.</h2>
        <p class="mt-4 text-slate-600 leading-relaxed">{config.about.intro}</p>
        <ul class="mt-6 space-y-3">
          {
            config.about.highlights.map((item) => (
              <li class="flex gap-3 text-sm text-slate-700">
                <span class="mt-0.5 font-bold text-brand-accent" aria-hidden="true">→</span>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>
        <a href="/about" class="btn-secondary mt-8">About the practice</a>
      </div>
      <div class="rounded-2xl bg-brand-primary p-8 text-white sm:p-10">
        <p class="font-display text-2xl leading-snug sm:text-3xl">
          “We explain the options, file on time, and pick up the phone.”
        </p>
        <p class="mt-6 text-sm text-slate-300">
          That is the standard we set for every engagement — whether you are lodging a first company return
          or tightening BAS routines across a multi-site operation.
        </p>
        <a href={config.phoneHref} class="btn-accent mt-8">{config.hero.primaryCta}</a>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import config from '../config/site.config';

const title = 'Services';
const description = `Tax returns, BAS, bookkeeping and advisory from ${config.firmName} in ${config.suburb}, ${config.region}.`;
const isShopfront = config.layout === 'shopfront';
const isCoastal = config.layout === 'coastal';
const isEditorial = isShopfront || isCoastal;
---

<BaseLayout title={title} description={description}>
  <section class="relative overflow-hidden bg-brand-muted">
    <div class="container-page section-pad !pb-14">
      <p class="eyebrow">What we do</p>
      <h1 class="mt-3 text-4xl sm:text-5xl">Services</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-slate-600">
        Practical compliance and advisory for businesses and individuals across {config.suburb} and
        {config.region}. Packages are scoped after a short discovery call.
      </p>
    </div>
  </section>

  <section class="section-pad">
    <div class="container-page space-y-6">
      {
        config.services.map((service, i) => (
          <article
            id={service.slug}
            class:list={[
              'scroll-mt-28 p-7 sm:p-8',
              isEditorial
                ? 'service-row rounded-lg bg-white shadow-sm ring-1 ring-slate-200/80'
                : 'card',
            ]}
          >
            <div class="grid gap-8 lg:grid-cols-12">
              <div class="lg:col-span-4">
                {isEditorial ? (
                  <div class:list={['flex items-center gap-3', isCoastal ? 'text-brand-primary' : 'text-brand-secondary']}>
                    {service.icon ? <Icon name={service.icon} size={20} /> : null}
                  </div>
                ) : (
                  <div class="flex items-center gap-3">
                    <span class="service-icon">
                      <Icon name="spark" size={18} />
                    </span>
                    <span class="text-xs font-semibold tabular-nums text-slate-400">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                  </div>
                )}
                <h2 class="mt-4 text-2xl">{service.title}</h2>
                <p class="mt-3 text-slate-600 leading-relaxed">{service.summary}</p>
              </div>
              <div class="lg:col-span-8">
                <h3 class="text-xs font-semibold uppercase tracking-[0.12em] text-brand-secondary">
                  Includes
                </h3>
                <ul class="mt-4 grid gap-3 sm:grid-cols-2">
                  {service.details.map((detail) => (
                    <li class="flex gap-2.5 rounded-lg border border-slate-100 bg-slate-50/80 px-3.5 py-3 text-sm text-slate-700">
                      <span class="mt-0.5 text-brand-accent">
                        <Icon name="check" size={14} />
                      </span>
                      <span>{detail}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </section>

  <section class="border-t border-slate-200 bg-white">
    <div class="container-page section-pad max-w-3xl text-center">
      <p class="eyebrow justify-center">Not sure where to start?</p>
      <h2 class="mt-3 text-3xl">Not sure which package fits?</h2>
      <p class="mt-4 text-slate-600 leading-relaxed">
        Call us and we will map your lodging calendar, software, and priorities before quoting. No long
        questionnaires — a 15-minute conversation is usually enough to start.
      </p>
      <a href={config.phoneHref} class="btn-primary mt-8">
        <Icon name="phone" size={16} />
        {config.hero.primaryCta}
      </a>
    </div>
  </section>

  <CtaBand />
</BaseLayout>
